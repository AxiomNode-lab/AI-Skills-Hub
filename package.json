{
  "name": "ai-skills-hub",
  "version": "0.2.0",
  "private": true,
  "description": "License-aware registry and distribution layer for AI Agent capabilities.",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "test": "node --test tests packages",
    "lint": "node scripts/static-check.mjs",
    "audit": "node scripts/audit-registry.mjs",
    "ingest": "node scripts/ingest-github.mjs",
    "generate-lock": "node scripts/generate-lockfile.mjs",
    "export-plugin": "node scripts/export-plugin.mjs",
    "dedupe": "node scripts/dedupe-report.mjs",
    "validate-materialized": "node scripts/validate-materialized.mjs",
    "validate-schemas": "node scripts/validate-schemas.mjs",
    "validate-all": "pnpm validate && pnpm validate-workspace && pnpm static-check && pnpm validate-schemas && pnpm generate-lock && pnpm validate-materialized && pnpm dedupe && pnpm test",
    "materialize": "node scripts/materialize.mjs",
    "sync-registry": "node scripts/sync-registry.mjs",
    "verify": "pnpm validate && pnpm validate-workspace && pnpm static-check && pnpm validate-schemas && pnpm test",
    "cli": "node packages/cli/bin/skills-hub.mjs",
    "validate-workspace": "node scripts/validate-workspace.mjs",
    "static-check": "node scripts/static-check.mjs",
    "validate-discovery": "node tests/discovery.test.mjs",
    "capability-schema-check": "node scripts/validate-capability-contract.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
