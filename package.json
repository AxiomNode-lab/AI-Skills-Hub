{
  "name": "ai-skills-hub",
  "version": "0.2.0",
  "private": true,
  "description": "License-aware registry for AI Agent Skills.",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "test": "node --test",
    "lint": "node scripts/validate-registry.mjs",
    "audit": "node scripts/audit-registry.mjs",
    "ingest": "node scripts/ingest-github.mjs",
    "generate-lock": "node scripts/generate-lockfile.mjs",
    "export-plugin": "node scripts/export-plugin.mjs",
    "dedupe": "node scripts/dedupe-report.mjs",
    "validate-materialized": "node scripts/validate-materialized.mjs",
    "validate-all": "pnpm validate && pnpm generate-lock && pnpm validate-materialized && pnpm dedupe && pnpm test",
    "materialize": "node scripts/materialize.mjs",
    "mcp": "node apps/mcp-server/src/server.mjs",
    "api": "node apps/api/src/server.mjs",
    "web": "node apps/web/dev-server.mjs",
    "sync-registry": "node scripts/sync-registry.mjs",
    "verify": "pnpm validate && pnpm test",
    "cli": "node packages/cli/bin/skills-hub.mjs",
    "validate-workspace": "node scripts/validate-workspace.mjs",
    "static-check": "node scripts/static-check.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
