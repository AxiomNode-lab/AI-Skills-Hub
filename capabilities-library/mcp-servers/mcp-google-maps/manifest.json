{
  "id": "mcp-google-maps",
  "name": "Google Maps MCP Server",
  "type": "mcp-server",
  "description": "Fetch locations and directions.",
  "distribution": "bundled",
  "mcpConfig": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-google-maps"
    ]
  },
  "requiredEnv": [
    "GOOGLE_MAPS_API_KEY"
  ]
}