{
  "id": "mcp-slack",
  "name": "Slack MCP Server",
  "type": "mcp-server",
  "description": "Read and send messages to Slack channels.",
  "distribution": "bundled",
  "mcpConfig": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-slack"
    ]
  },
  "requiredEnv": [
    "SLACK_BOT_TOKEN",
    "SLACK_TEAM_ID"
  ]
}