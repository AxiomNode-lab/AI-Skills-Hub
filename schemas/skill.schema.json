{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills-hub.dev/schemas/skill.v0.2.schema.json",
  "type": "object",
  "required": [
    "artifact_type",
    "id",
    "name",
    "publisher",
    "source",
    "category",
    "license",
    "distribution",
    "compatibility",
    "security",
    "materialized",
    "release",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+(?:/[a-z0-9._-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revision_type": {
          "const": "git-commit"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "unknown"
          ]
        }
      }
    },
    "category": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "redistributable",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "type": "string"
        },
        "redistributable": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "verified",
            "unknown",
            "review-required"
          ]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "distribution": {
      "enum": [
        "bundled",
        "source-direct",
        "review-required",
        "blocked"
      ]
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security": {
      "type": "object",
      "required": [
        "scan_status",
        "risk"
      ],
      "additionalProperties": true,
      "properties": {
        "scan_status": {
          "enum": [
            "verified",
            "pending",
            "review-required"
          ]
        },
        "risk": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "network": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "shell": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "credentials": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dynamic_execution": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "package_install": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "filesystem_write": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "encoded_content": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "materialized": {
      "type": "boolean"
    },
    "materialized_root": {
      "type": "string"
    },
    "release": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "eligible",
            "hold"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream_skill_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[0-9a-f]{64}$|^$"
        },
        "last_ingested_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true
    },
    "artifact_type": {
      "const": "skill"
    }
  }
}
