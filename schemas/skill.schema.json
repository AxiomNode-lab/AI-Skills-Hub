{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id","name","publisher","source","category","license","distribution","compatibility","security"],
  "properties": {
    "id": {"type":"string","minLength":3},
    "name": {"type":"string","minLength":1},
    "publisher": {"type":"string","minLength":1},
    "source": {
      "type":"object",
      "required":["repo","path"],
      "properties":{
        "repo":{"type":"string"},
        "path":{"type":"string"},
        "revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "revision_type":{"const":"git-commit"},
        "url":{"type":"string","format":"uri"}
      },
      "additionalProperties":false
    },
    "category":{"type":"array","items":{"type":"string"},"minItems":1},
    "license":{
      "type":"object",
      "required":["spdx","redistributable","status"],
      "properties":{
        "spdx":{"type":"string"},
        "redistributable":{"type":"boolean"},
        "status":{"enum":["verified","unknown","review-required"]}
      },
      "additionalProperties":false
    },
    "distribution":{"enum":["bundled","source-direct","review-required","blocked"]},
    "compatibility":{"type":"array","items":{"type":"string"}},
    "security":{
      "type":"object",
      "required":["scan_status"],
      "properties":{
        "scan_status":{"enum":["verified","pending","review-required"]},
        "network":{"type":["boolean","null"]},
        "shell":{"type":["boolean","null"]},
        "credentials":{"type":["boolean","null"]}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":false
}
