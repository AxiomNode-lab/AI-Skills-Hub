{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-skills-hub.dev/schemas/agents.v0.2.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "nativeSkillDirs"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "nativeSkillDirs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "userSkillDirs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pluginSupport": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
